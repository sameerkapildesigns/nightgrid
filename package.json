{
  "name": "nightgrid",
  "private": true,
  "version": "0.6.0-m4",
  "description": "NIGHTGRID anti-gravity racer: single-player + private-room multiplayer (M4, local test build)",
  "type": "module",
  "license": "SEE LICENSE IN NOTICE.md",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:test": "vite build --mode test --outDir dist-test",
    "preview": "vite preview",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "npm run build:test && node tests/e2e/run.mjs && node tests/e2e/rain-check.mjs",
    "measure": "node scripts/measure.mjs",
    "scan": "node scripts/secret-scan.mjs",
    "test:net": "node --test \"tests/net/*.test.mjs\"",
    "test:matrix": "node tests/net/matrix.mjs",
    "mp:server": "node server/local.mjs",
    "mp": "vite build && node server/local.mjs",
    "build-id": "node scripts/build-id.mjs",
    "test:mp": "vite build --mode test --outDir dist-test && node tests/e2e/mp-run.mjs"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "vite": "6.3.5",
    "ws": "8.18.0"
  }
}
